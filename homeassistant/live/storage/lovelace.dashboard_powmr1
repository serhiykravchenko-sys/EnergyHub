                        "mounted": "EVAL:function(chart) {\n  requestAnimationFrame(function() {\n    if (chart.el.isConnected) chart.w.config.chart.events.updated(chart);\n  });\n  const host=chart.el.getRootNode().host;\n  if (!host) return;\n  if (host.__ehForecastResizeObserver) host.__ehForecastResizeObserver.disconnect();\n  let lastWidth=0;\n  const observer=new ResizeObserver(function() {\n    if (!host.isConnected || !chart.el.isConnected) { observer.disconnect(); return; }\n    const width=Math.floor(host.getBoundingClientRect().width);\n    if (width>0 && width!==lastWidth) {\n      lastWidth=width;\n      chart.updateOptions({chart:{width:width}},false,false,false);\n    }\n  });\n  host.__ehForecastResizeObserver=observer;\n  observer.observe(host);\n}",
                        "updated": "EVAL:function(chart) {\n  const id='energyhub_average_full_width';\n  const data=chart.w.config.series[1]?.data || [];\n  const point=data.find(p=>Number.isFinite(Array.isArray(p) ? p[1] : p?.y));\n  const value=Array.isArray(point) ? point[1] : point?.y;\n  const rows=chart.w.config.annotations.yaxis || [];\n  const old=rows.find(row=>row.id===id);\n  const pad=chart.w.globals.barPadForNumericAxis || 0;\n  const width=String(Math.round(chart.w.globals.gridWidth+2*pad));\n  if (Number.isFinite(value)) {\n    if (chart.el.querySelector('.apexcharts-yaxis-annotations line') && old && old.y===value && old.borderWidth===4 && old.offsetX===-pad && old.width===width) return;\n    const next=rows.filter(row=>row.id!==id);\n    next.push({id:id,y:value,borderColor:'#3498db',borderWidth:4,offsetX:-pad,width:width,strokeDashArray:0,opacity:1});\n    chart.updateOptions({annotations:{yaxis:next}},false,false,false);\n  } else if (old) {\n    chart.updateOptions({annotations:{yaxis:rows.filter(row=>row.id!==id)}},false,false,false);\n  }\n}"
