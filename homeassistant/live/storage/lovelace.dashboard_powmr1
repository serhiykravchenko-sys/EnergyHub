                          "content": "{% set reserve = states('input_number.ahm_minimum_soc') | int(20) %}\n{% set marker = '🟢' if reserve <= 20 else '🟡' if reserve <= 30 else '🟠' if reserve <= 40 else '🔴' %}\n# {{ marker }} {{ reserve }}%\n**ACTIVE RESERVE**"
                        },
