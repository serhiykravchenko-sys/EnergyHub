_requires_attention':'Restore rejected'} %}\n{% set base_check = 'Controller fault' if state_attr(e, 'fault') else 'Device offline' if availability == 'offline' else 'Availability unknown' if not availability_valid else 'Device unavailable' if not state_valid else 'Power unavailable' if not power_valid else 'Snapshot stale · ' ~ (age | round(0) | int) ~ ' s' if not snapshot_fresh else 'Blocked: ' ~ blocked_labels.get(blocked, blocked | replace('_', ' ')) if blocked else 'Native checks pending' if key == 'heat_pump_floor_1' and row.get('control_ready') != true else 'Bridge not ready' if row.get('control_ready') != true or not row.get('context_id') or row.get('intent_revision') is none else 'Ready' %}\n{% set check = base_check ~ (' · power unchanged' if base_check == 'Ready' and power_unchanged else '') %}\n{% set ns.lines = ns.lines + ['| ' ~ loop.index ~ '. ' ~ name ~ ' | ' ~ (row.get('state') | title if state_valid else 'Unknown') ~ ' / ' ~ ((power | round(0) | int) ~ ' W' if power_valid else '—') ~ ' | ' ~ check ~ ' |'] %}\n{% endfor %}\n| Device · switching order | State / Power | Checks |\n|:--|:--|:--|\n{{ ns.lines | join('\\n') }}\n\nFirst-floor heat pump: native Heat/Off control; its smart plug stays powered and measures consumption. Other devices use their smart plugs.\nZigbee online/offline uses Zigbee2MQTT device availability, not watt-report age. Unchanged watts remain visible and do not by themselves make an online device unavailable; every automatic command still requires acknowledgement and a new post-command observation."
