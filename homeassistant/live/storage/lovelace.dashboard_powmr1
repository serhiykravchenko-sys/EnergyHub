                      "data_generator": "const today = new Date(); today.setHours(0,0,0,0);\nconst points = Array.from({length:5}, (_,i) => { const d=new Date(today); d.setDate(d.getDate()+i); d.setHours(12); return d; });\nconst ids=[\"sensor.solcast_pv_forecast_forecast_today\", \"sensor.solcast_pv_forecast_forecast_tomorrow\", \"sensor.solcast_pv_forecast_forecast_day_3\", \"sensor.solcast_pv_forecast_forecast_day_4\", \"sensor.solcast_pv_forecast_forecast_day_5\", \"sensor.solcast_pv_forecast_forecast_day_6\", \"sensor.solcast_pv_forecast_forecast_day_7\"];\nconst refresh=hass.states['sensor.solcast_pv_forecast_api_last_polled'];\nconst age=refresh ? Date.now()-Date.parse(refresh.state) : NaN;\nconst fresh=Number.isFinite(age) && age>=0 && age<=86400000;\nreturn points.map((d,i) => {\n  const row=hass.states[ids[i]], a=row?.attributes || {};\n  const raw=row?.state, n=(raw!==undefined && raw.trim()!=='') ? Number(raw) : NaN;\n  const detail=a.detailedForecast || a.detailed_forecast;\n  let dated=a.dayname===d.toLocaleDateString('en-US',{weekday:'long'});\n  if (Array.isArray(detail) && detail.length) {\n    const stamp=new Date(detail[0].period_start);\n    dated=!isNaN(stamp) && stamp.toDateString()===d.toDateString();\n  }\n  return [today.getTime()+43200000+i*86400000, fresh && dated && a.unit_of_measurement==='kWh' && Number.isFinite(n) && n>=0 && n<=1000 ? n : null];\n});",
